{
  "functions": {
    "welcome_and_stage_detection": {
      "feature_id": "welcome_and_stage_detection",
      "stage": "global",
      "description": "Default greeting, stage recognition, task recognition, and first-round field completeness check.",
      "trigger_examples": [
        "你好，我想带狗去上海玩三天",
        "我现在在北京旅游途中，猫有点应激怎么办"
      ],
      "input_fields": [
        "current_user_message",
        "session_id(optional)",
        "output_language(optional)"
      ],
      "output_fields": [
        "welcome_message",
        "stage",
        "primary_task",
        "sub_tasks",
        "recognized_fields",
        "missing_required_fields",
        "follow_up_question",
        "next_step"
      ],
      "memory_read_fields": [
        "session_id",
        "user_profile_summary",
        "pet_profile_summary",
        "trip_context_summary",
        "historical_preference_summary"
      ],
      "api_request_fields": [],
      "model_io_logic": {
        "4.1-mini": {
          "input_fields": [
            "current_user_message",
            "memory_summary",
            "supported_stage_list",
            "supported_task_list",
            "task_required_field_registry",
            "output_language_hint"
          ],
          "output_fields": [
            "welcome_message",
            "recognized_stage",
            "recognized_primary_task",
            "recognized_sub_tasks",
            "recognized_field_values",
            "missing_required_fields",
            "follow_up_question_if_needed",
            "tool_invocation_decision",
            "structured_task_stub_json"
          ]
        },
        "5.1-mini": {
          "input_fields": [],
          "output_fields": []
        }
      },
      "notes": [
        "This block normally does not need 5.1-mini."
      ]
    },
    "document_material_reminder": {
      "feature_id": "document_material_reminder",
      "stage": "pre_trip",
      "description": "Generate travel document and material reminder for user and pet. Default output in pre-trip stage.",
      "trigger_examples": [
        "告诉我需要带什么证件",
        "带猫出门需要准备哪些材料"
      ],
      "input_fields": [
        "destination_city",
        "travel_start_date(optional)",
        "travel_end_date(optional)",
        "user_identity_info(optional)",
        "pet_type",
        "pet_vaccinated(optional)",
        "pet_special_needs(optional)",
        "output_language"
      ],
      "output_fields": [
        "user_document_checklist",
        "pet_document_checklist",
        "optional_material_checklist",
        "compliance_notice",
        "pre_departure_tips"
      ],
      "memory_read_fields": [
        "user_profile_summary",
        "pet_profile_summary",
        "trip_context_summary"
      ],
      "api_request_fields": [
        {
          "api_name": "static_document_rule_db",
          "purpose": "Load document/material rules for travelers and pets",
          "request_fields": [
            "destination_city",
            "travel_date_range(optional)",
            "pet_type",
            "pet_vaccinated(optional)",
            "output_language"
          ]
        }
      ],
      "model_io_logic": {
        "4.1-mini": {
          "input_fields": [
            "current_user_message",
            "parsed_profile_fields",
            "pet_profile_summary",
            "trip_context_summary",
            "static_rule_result"
          ],
          "output_fields": [
            "normalized_document_request_json",
            "user_document_checklist",
            "pet_document_checklist",
            "optional_material_checklist",
            "lightweight_explanation"
          ]
        },
        "5.1-mini": {
          "input_fields": [],
          "output_fields": []
        }
      },
      "notes": [
        "Handled by 4.1-mini plus static rule lookup in the source design."
      ]
    },
    "scenic_recommendation": {
      "feature_id": "scenic_recommendation",
      "stage": "pre_trip",
      "description": "Recommend scenic spots by category under pet-friendly, budget, and pet-profile constraints.",
      "trigger_examples": [
        "推荐一些适合带狗玩的上海景点",
        "帮我找北京宠物友好的历史景点"
      ],
      "input_fields": [
        "destination_city",
        "hotel_area(optional)",
        "target_area(optional)",
        "trip_days(optional)",
        "budget_total(optional)",
        "budget_per_person(optional)",
        "pet_type",
        "pet_breed(optional)",
        "pet_age",
        "pet_weight_kg",
        "pet_special_needs(optional)",
        "preferred_categories(optional)",
        "output_language"
      ],
      "output_fields": [
        "recommended_scenic_spots_by_category",
        "category_name",
        "scenic_spot_name",
        "scenic_type",
        "indoor_or_outdoor",
        "ticket_required",
        "ticket_price",
        "visitor_review_summary",
        "pet_friendly_evidence",
        "recommendation_reason"
      ],
      "memory_read_fields": [
        "user_profile_summary",
        "pet_profile_summary",
        "trip_context_summary",
        "historical_preference_summary"
      ],
      "api_request_fields": [
        {
          "api_name": "amap_geocode",
          "purpose": "Convert destination/hotel/target area text to standard location object",
          "request_fields": [
            "destination_city",
            "hotel_area(optional)",
            "target_area(optional)"
          ]
        },
        {
          "api_name": "amap_poi_search",
          "purpose": "Search candidate POIs for five required categories",
          "request_fields": [
            "standard_location",
            "search_radius(optional)",
            "category",
            "city_limit",
            "page_size",
            "page_no(optional)"
          ]
        },
        {
          "api_name": "amap_poi_detail",
          "purpose": "Fetch detailed scenic information",
          "request_fields": [
            "poi_ids"
          ]
        },
        {
          "api_name": "review_tag_db",
          "purpose": "Load offline review summary and pet-friendly tags",
          "request_fields": [
            "poi_ids",
            "destination_city",
            "pet_type",
            "pet_breed(optional)",
            "pet_age",
            "pet_weight_kg"
          ]
        },
        {
          "api_name": "pet_friendly_rule_db",
          "purpose": "Load pet-friendly constraints and screening rules",
          "request_fields": [
            "pet_type",
            "pet_breed(optional)",
            "pet_age",
            "pet_weight_kg",
            "budget_total(optional)",
            "budget_per_person(optional)"
          ]
        }
      ],
      "model_io_logic": {
        "4.1-mini": {
          "input_fields": [
            "current_user_message",
            "parsed_user_fields",
            "pet_profile_summary",
            "budget_summary",
            "amap_geocode_result",
            "amap_poi_search_result",
            "amap_poi_detail_result",
            "review_tag_db_result",
            "pet_friendly_rule_result"
          ],
          "output_fields": [
            "normalized_scenic_request_json",
            "initial_filter_conditions",
            "filtered_candidate_spots",
            "classified_spots_by_five_categories",
            "constraint_summary",
            "display_ready_recommendation_payload"
          ]
        },
        "5.1-mini": {
          "input_fields": [],
          "output_fields": []
        }
      },
      "notes": [
        "Original design uses 4.1-mini for first-round filtering and category classification."
      ]
    },
    "travel_route_planning": {
      "feature_id": "travel_route_planning",
      "stage": "pre_trip",
      "description": "Generate 2-3 travel route plans using weather, pet constraints, budget, operating hours, hotel distance, and route matrix.",
      "trigger_examples": [
        "帮我规划上海三日游路线",
        "带猫去北京，住在国贸附近，给我两套路线"
      ],
      "input_fields": [
        "destination_city",
        "travel_start_date",
        "travel_end_date(optional)",
        "trip_days",
        "hotel_name(optional)",
        "hotel_area(optional)",
        "hotel_address(optional)",
        "daily_play_hours",
        "transport_preference",
        "budget_total(optional)",
        "budget_per_person(optional)",
        "pace_preference(optional)",
        "target_pois(optional)",
        "pet_type",
        "pet_breed(optional)",
        "pet_age",
        "pet_weight_kg",
        "pet_special_needs(optional)",
        "output_language"
      ],
      "output_fields": [
        "route_plan_options",
        "option_id",
        "option_summary",
        "daily_total_play_hours",
        "day_index",
        "scenic_order",
        "scenic_name",
        "planned_stay_duration_minutes",
        "transport_mode_between_nodes",
        "commute_duration_minutes",
        "estimated_total_cost",
        "route_reasoning",
        "constraint_notes"
      ],
      "memory_read_fields": [
        "user_profile_summary",
        "pet_profile_summary",
        "trip_context_summary",
        "historical_preference_summary"
      ],
      "api_request_fields": [
        {
          "api_name": "pet_transport_rule_db",
          "purpose": "Confirm hard constraints between pet profile and transport modes",
          "request_fields": [
            "pet_type",
            "pet_breed(optional)",
            "pet_age",
            "pet_weight_kg",
            "transport_preference",
            "destination_city"
          ]
        },
        {
          "api_name": "weather_api",
          "purpose": "Fetch travel-date weather constraints",
          "request_fields": [
            "destination_city",
            "travel_start_date",
            "travel_end_date(optional)"
          ]
        },
        {
          "api_name": "amap_geocode",
          "purpose": "Normalize hotel and scenic locations",
          "request_fields": [
            "destination_city",
            "hotel_name(optional)",
            "hotel_area(optional)",
            "hotel_address(optional)",
            "target_pois(optional)"
          ]
        },
        {
          "api_name": "amap_poi_search",
          "purpose": "Fetch candidate scenic spots",
          "request_fields": [
            "destination_city",
            "hotel_standard_location(optional)",
            "target_categories(optional)",
            "search_radius(optional)",
            "page_size"
          ]
        },
        {
          "api_name": "amap_poi_detail",
          "purpose": "Fetch ticket price and opening details",
          "request_fields": [
            "poi_ids"
          ]
        },
        {
          "api_name": "amap_route_matrix",
          "purpose": "Calculate hotel-to-spot and spot-to-spot commute duration and distance",
          "request_fields": [
            "origin_locations",
            "destination_locations",
            "transport_mode"
          ]
        }
      ],
      "model_io_logic": {
        "4.1-mini": {
          "input_fields": [
            "current_user_message",
            "parsed_user_fields",
            "pet_profile_summary",
            "trip_context_summary",
            "pet_transport_rule_result",
            "weather_result",
            "amap_geocode_result",
            "amap_poi_search_result",
            "amap_poi_detail_result",
            "amap_route_matrix_result"
          ],
          "output_fields": [
            "first_round_filtered_candidates",
            "normalized_time_constraints",
            "normalized_budget_constraints",
            "normalized_pet_constraints",
            "normalized_route_solver_input_json",
            "context_summary_for_5.1-mini"
          ]
        },
        "5.1-mini": {
          "input_fields": [
            "normalized_route_solver_input_json",
            "candidate_spots_with_metadata",
            "route_matrix_summary",
            "weather_constraints",
            "pet_constraints",
            "budget_constraints",
            "opening_hour_constraints",
            "hotel_distance_constraints",
            "required_output_format"
          ],
          "output_fields": [
            "route_plan_options",
            "per_option_node_sequence",
            "per_node_planned_stay_minutes",
            "per_leg_transport_mode",
            "per_leg_commute_minutes",
            "daily_play_hours_summary",
            "estimated_total_cost",
            "route_reasoning",
            "constraint_satisfaction_notes"
          ]
        }
      },
      "notes": [
        "4.1-mini packages the unified route-solver input and 5.1-mini outputs the route options."
      ]
    },
