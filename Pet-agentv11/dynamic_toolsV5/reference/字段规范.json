    "route_replanning": {
      "feature_id": "route_replanning",
      "stage": "in_trip",
      "description": "Generate 1-2 alternative route plans based on current location, time, weather, traffic, and original route context.",
      "trigger_examples": [
        "现在下雨了，帮我重新规划今天的路线",
        "我已经到外滩了，后面的路线怎么改"
      ],
      "input_fields": [
        "current_time",
        "current_location_text",
        "current_standard_location(optional)",
        "user_current_status(optional)",
        "pet_current_status(optional)",
        "current_weather(optional)",
        "traffic_status(optional)",
        "remaining_play_time_hours(optional)",
        "current_budget_remaining(optional)",
        "output_language"
      ],
      "output_fields": [
        "replanned_route_options",
        "option_id",
        "replaced_original_nodes",
        "new_route_sequence",
        "transport_mode_per_leg",
        "commute_duration_per_leg",
        "adjusted_total_play_hours",
        "adjustment_reason",
        "cost_delta",
        "new_total_cost"
      ],
      "memory_read_fields": [
        "user_profile_summary",
        "pet_profile_summary",
        "trip_context_summary",
        "generated_itinerary_summary",
        "historical_preference_summary"
      ],
      "api_request_fields": [
        {
          "api_name": "weather_api",
          "purpose": "Fetch current weather and short-term changes",
          "request_fields": [
            "current_standard_location",
            "current_time"
          ]
        },
        {
          "api_name": "amap_traffic_api",
          "purpose": "Fetch current traffic congestion status",
          "request_fields": [
            "current_standard_location",
            "time_window(optional)",
            "route_corridor(optional)"
          ]
        },
        {
          "api_name": "amap_poi_search",
          "purpose": "Find nearby alternative resources",
          "request_fields": [
            "current_standard_location",
            "candidate_categories(optional)",
            "search_radius",
            "page_size"
          ]
        },
        {
          "api_name": "amap_route_matrix",
          "purpose": "Calculate commute from current location to substitutes and remaining nodes",
          "request_fields": [
            "origin_locations",
            "destination_locations",
            "transport_mode_set"
          ]
        }
      ],
      "model_io_logic": {
        "4.1-mini": {
          "input_fields": [
            "current_user_message",
            "live_context_fields",
            "user_profile_summary",
            "pet_profile_summary",
            "generated_itinerary_summary",
            "historical_preference_summary",
            "weather_result",
            "traffic_result",
            "amap_poi_search_result",
            "amap_route_matrix_result"
          ],
          "output_fields": [
            "affected_original_nodes",
            "must_replace_nodes",
            "normalized_replanning_constraints",
            "normalized_replanning_input_json",
            "context_summary_for_5.1-mini"
          ]
        },
        "5.1-mini": {
          "input_fields": [
            "normalized_replanning_input_json",
            "original_route_summary",
            "current_location_and_time_boundary",
            "affected_nodes",
            "candidate_replacement_nodes",
            "route_matrix_summary",
            "weather_constraints",
            "traffic_constraints",
            "pet_transport_constraints",
            "remaining_time_constraints",
            "budget_constraints",
            "required_output_format"
          ],
          "output_fields": [
            "replanned_route_options",
            "replaced_original_nodes",
            "new_route_sequence",
            "transport_mode_per_leg",
            "commute_duration_per_leg",
            "adjusted_total_play_hours",
            "adjustment_reason",
            "cost_delta",
            "new_total_cost"
          ]
        }
      },
      "notes": [
        "Final 1-2 replacement route options are produced by 5.1-mini after 4.1-mini packages structured constraints."
      ]
    },
